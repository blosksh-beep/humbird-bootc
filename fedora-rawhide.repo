[fedora-rawhide]
name=Fedora Rawhide - $basearch (dl.fedoraproject.org CDN)
baseurl=https://dl.fedoraproject.org/pub/fedora/linux/development/rawhide/Everything/$basearch/os/
enabled=1
countme=1
metadata_expire=6h
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-46-primary
skip_if_unavailable=False
